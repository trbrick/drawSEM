#!/bin/bash
set -e

# The R package ships a copy of the schema (inst/extdata/graph.schema.json).
# Fail if the staged copy differs from the staged source of truth.
SRC=drawsem-web/schema/graph.schema.json
DST=inst/extdata/graph.schema.json
if ! cmp -s <(git show ":$SRC" 2>/dev/null) <(git show ":$DST" 2>/dev/null); then
    echo "pre-commit: $DST is out of sync with $SRC."
    echo "Run 'make' to copy it, then 'git add $DST'."
    exit 1
fi

# Rebuild the widget if anything that feeds the bundle changed: source, schema,
# build config, or dependencies (package.json / package-lock.json).
if git diff --cached --name-only | grep -qE '^drawsem-web/(src/|schema/|vite|tailwind|postcss|package(-lock)?\.json$)'; then
    echo "Detected web tool changes. Rebuilding widget..."

    cd drawsem-web

    # The build uses the installed node_modules, but CI builds from the
    # lockfile (npm ci). Refuse to build if they disagree, or the committed
    # widget would fail CI's stale-widget check.
    if ! node -e '
        const fs = require("fs");
        const lock = JSON.parse(fs.readFileSync("package-lock.json", "utf8")).packages;
        let inst;
        try { inst = JSON.parse(fs.readFileSync("node_modules/.package-lock.json", "utf8")).packages; }
        catch (e) { console.error("node_modules is missing."); process.exit(1); }
        const bad = Object.entries(lock).filter(([k, v]) =>
            k !== "" && !v.optional && (!inst[k] || inst[k].version !== v.version));
        if (bad.length) {
            bad.slice(0, 5).forEach(([k, v]) => console.error("  " + k + ": lockfile " + v.version + ", installed " + (inst[k] ? inst[k].version : "none")));
            process.exit(1);
        }'; then
        echo "pre-commit: drawsem-web/node_modules does not match package-lock.json."
        echo "Run 'npm install' (or 'npm ci') in drawsem-web/, then commit again."
        exit 1
    fi

    npm run build:widget
    cd ..
    
    # Stage the built assets
    git add inst/htmlwidgets/lib/app/widget.js
    git add inst/htmlwidgets/lib/app/widget.css 2>/dev/null || true
    
    echo "Widget rebuilt and staged"
fi

exit 0
