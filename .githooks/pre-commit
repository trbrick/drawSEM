#!/bin/bash
set -e

# The R package ships a copy of the schema (inst/extdata/graph.schema.json).
# Fail if the staged copy differs from the staged source of truth.
SRC=drawsem-web/schema/graph.schema.json
DST=inst/extdata/graph.schema.json
if ! cmp -s <(git show ":$SRC" 2>/dev/null) <(git show ":$DST" 2>/dev/null); then
    echo "pre-commit: $DST is out of sync with $SRC."
    echo "Run 'make' to copy it, then 'git add $DST'."
    exit 1
fi

# Check if web-tool source files changed
if git diff --cached --name-only | grep -qE 'drawsem-web/src|drawsem-web/schema|drawsem-web/vite'; then
    echo "Detected web tool changes. Rebuilding widget..."
    
    cd drawsem-web
    npm run build:widget
    cd ..
    
    # Stage the built assets
    git add inst/htmlwidgets/lib/app/widget.js
    git add inst/htmlwidgets/lib/app/widget.css 2>/dev/null || true
    
    echo "Widget rebuilt and staged"
fi

exit 0
